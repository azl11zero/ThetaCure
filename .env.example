# ThetaCure Platform Environment Variables
NEXT_PUBLIC_APP_NAME="ThetaCure"
NEXT_PUBLIC_APP_TAGLINE="For the Ones You Love. For the Care They Deserve."
NEXT_PUBLIC_DEFAULT_CITY="Dhaka"
NEXT_PUBLIC_DEFAULT_CURRENCY="৳"

# Supabase Backend (PostgreSQL, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Doctor Finder & Symptom Guidance Engine
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Payment Gateway (SSLCommerz / bKash / Nagad)
SSLCOMMERZ_STORE_ID=thetacure_live
SSLCOMMERZ_STORE_PASS=your-store-pass
SSLCOMMERZ_IS_SANDBOX=true

# Notification & SMS Service
SMS_GATEWAY_API_KEY=your-sms-api-key
EMAIL_SERVER_HOST=smtp.sendgrid.net
EMAIL_SERVER_PORT=587
EMAIL_FROM=no-reply@thetacure.com
